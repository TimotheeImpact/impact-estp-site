---
layout: null
sitemap: false
---
{%- comment -%}
  Plan du site pour Google (remplace celui que fabrique jekyll-sitemap, en reprenant son contenu).
  Seule différence : les pages des rubriques listées dans « rubriques_masquees » (_config.yml) n'y sont pas.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign collections = site.collections | where_exp: 'collection', 'collection.output != false' %}
{%- for collection in collections %}
  {%- assign docs = collection.docs | where_exp: 'doc', 'doc.sitemap != false' %}
  {%- for doc in docs %}
  {%- if doc.rubrique and site.rubriques_masquees contains doc.rubrique %}{% continue %}{% endif %}
  <url>
    <loc>{{ doc.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
    {%- if doc.last_modified_at or doc.date %}
    <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
  {%- endfor %}
{%- endfor %}
{%- assign pages = site.html_pages | where_exp: 'doc', 'doc.sitemap != false' | where_exp: 'doc', 'doc.url != "/404.html"' %}
{%- for pg in pages %}
  {%- if pg.rubrique and site.rubriques_masquees contains pg.rubrique %}{% continue %}{% endif %}
  <url>
    <loc>{{ pg.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
    {%- if pg.last_modified_at %}
    <lastmod>{{ pg.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
{%- for file in site.static_files %}
  {%- unless file.extname == ".html" or file.extname == ".htm" or file.extname == ".xhtml" or file.extname == ".pdf" %}{% continue %}{% endunless %}
  {%- if file.sitemap == false or file.name == "404.html" %}{% continue %}{% endif %}
  <url>
    <loc>{{ file.path | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
    <lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
</urlset>
